# ==============================================================================
# PUB AttendEye - Docker Environment Configuration Template
# ==============================================================================
# Copy this file to .env.docker and populate required secrets before starting:
#   cp .env.docker.example .env.docker
# ==============================================================================

# ------------------------------------------------------------------------------
# Cryptographic Keys (REQUIRED)
# ------------------------------------------------------------------------------
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Token expiration in minutes
JWT_MINUTES=60

# ------------------------------------------------------------------------------
# Storage & Database Paths (Container-Internal)
# ------------------------------------------------------------------------------
# SQLite database path inside the persistent named volume 'attendeye-data'
DATABASE_URL=sqlite:////app/data/attendeye.db

# Encrypted review crop storage inside persistent named volume 'attendeye-private'
PRIVATE_DIR=/app/private

# Pre-downloaded model paths mounted read-only from host ./backend/models
MODEL_ROOT=/app/backend/models/insightface
FACE_MODEL=buffalo_l
MINIFAS_PATH=/app/backend/models/minifasnet.onnx

# ------------------------------------------------------------------------------
# Network & Proxy Security
# ------------------------------------------------------------------------------
# TrustedHostMiddleware allowed Host headers
ALLOWED_HOSTS=127.0.0.1,localhost,backend,127.0.0.1:8080,localhost:8080,127.0.0.1:8000,localhost:8000

# CORSMiddleware permitted origins
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Thread & Concurrency Limits (8 GB RAM Optimizations)
# ------------------------------------------------------------------------------
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
VECLIB_MAXIMUM_THREADS=2
NUMEXPR_NUM_THREADS=2

# ------------------------------------------------------------------------------
# Inference & Ingestion Tuning
# ------------------------------------------------------------------------------
DET_SIZE=640
MIN_FACE_SIZE=60
MIN_BLUR=45
MIN_BRIGHTNESS=35
MAX_POSE=48
TILED_DETECTION=true
TILE_SIZE=1000
TILE_OVERLAP=0.25
UPSCALE_SMALL_FACES=true
MAX_IMAGE_PIXELS=16000000
MAX_UPLOAD_MB=8
MAX_REQUEST_MB=66

# Passive Anti-Spoofing Cutoff
MINIFAS_THRESHOLD=0.80
MINIFAS_SCALE=2.7
PASSIVE_MIN_SIZE=80
BASELINE_AUTO_ACCEPT=false

# Debug Telemetry
DEBUG_RECOGNITION=false
